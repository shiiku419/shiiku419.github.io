---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PublicationEntry from "../components/PublicationEntry.astro";
import { publications, type PublicationCategory } from "../data/publications";
import { awards } from "../data/awards";

const groups: { category: PublicationCategory; title: string }[] = [
  { category: "journal", title: "Journal Articles" },
  { category: "paper", title: "International Conference Papers" },
  { category: "talk", title: "Workshops & Conference Talks" },
  { category: "preprint", title: "Preprints" },
  { category: "domestic", title: "Domestic Conference (Japan)" },
  { category: "thesis", title: "Theses" },
  { category: "grant", title: "Grants" }
];
---

<Layout title="Publications" description="Publications by Shota Shiiku across cognitive science, decision-making, social interaction, music cognition, and sports analytics.">
  <section class="mx-auto max-w-5xl px-6 py-12 sm:py-16">
    <SectionHeading eyebrow="Research" title="Publications" />

    {
      groups.map(({ category, title }) => {
        const items = publications.filter((p) => p.category === category);
        if (items.length === 0) return null;
        return (
          <div class="pub-group mb-10" data-category={category}>
            <h2 class="mb-1 text-lg font-semibold tracking-tight">{title}</h2>
            <ol class="pub-list divide-y divide-[var(--border)]">
              {items.map((publication) => (
                <li
                  class="pub-item flex gap-3 py-3"
                >
                  <span class="pub-index shrink-0 pt-0.5 text-sm tabular-nums text-[var(--text-muted)]" />
                  <PublicationEntry publication={publication} />
                </li>
              ))}
            </ol>
          </div>
        );
      })
    }

    <div id="awards" class="scroll-mt-8 border-t border-[var(--border)] pt-10">
      <h2 class="mb-4 text-xl font-semibold">Honors &amp; Awards</h2>
      <ul class="grid gap-4 sm:grid-cols-2">
        {
          awards.map((award) => (
            <li class="rounded-2xl border border-[var(--border)] bg-[var(--bg-elevated)] p-5">
              <p class="font-semibold">{award.title}</p>
              <p class="mt-1 text-sm text-[var(--text-muted)]">
                {award.organization}, {award.year}
              </p>
              {award.detail && <p class="mt-2 text-sm text-[var(--text-muted)]">{award.detail}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>

<style>
  .pub-list {
    counter-reset: pub;
  }
  .pub-item {
    counter-increment: pub;
  }
  .pub-index::before {
    content: counter(pub) ".";
  }
</style>

