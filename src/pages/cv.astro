---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
---

<Layout title="CV" description="CV of Shota Shiiku — Software Engineer and cognitive-science PhD researcher.">
  <section class="mx-auto max-w-4xl px-6 py-12 sm:py-16">
    <div class="flex items-center justify-between">
      <SectionHeading eyebrow="Résumé" title="Curriculum Vitae" />
      <a
        href="/Shota_Shiiku_CV.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full px-4 py-2 text-sm font-medium text-white transition-transform hover:scale-105"
        style="background: var(--accent-sage);"
      >
        Download PDF
      </a>
    </div>

    <div class="mt-2 overflow-hidden rounded-2xl border border-[var(--border)] shadow-[var(--shadow)]">
      <object data="/Shota_Shiiku_CV.pdf" type="application/pdf" width="100%" height="1000" aria-label="Shota Shiiku CV">
        <p class="p-6 text-sm text-[var(--text-muted)]">
          Your browser can't display the embedded PDF.
          <a class="text-[var(--accent-violet-deep)] underline-offset-2 hover:underline" href="/Shota_Shiiku_CV.pdf">
            Open the CV directly
          </a>.
        </p>
      </object>
    </div>
  </section>
</Layout>
