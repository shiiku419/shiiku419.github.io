---
interface Props {
  eyebrow?: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<div class="mb-6">
  {eyebrow && <p class="text-xs font-medium uppercase tracking-wide text-[var(--accent-sage-deep)]">{eyebrow}</p>}
  <h2 class="mt-1 text-2xl font-semibold">{title}</h2>
</div>
