---
const navItems = [
  { href: "/", label: "Home", icon: "home" },
  { href: "/publications/", label: "Work", icon: "book" },
  { href: "/news/", label: "News", icon: "bell" },
  { href: "/cv/", label: "CV", icon: "file" }
];

const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<nav
  aria-label="Primary"
  class="fixed bottom-0 left-0 z-40 flex w-full items-center justify-around border-t border-[var(--border)] bg-[var(--bg-elevated)] py-1.5 md:sticky md:top-0 md:h-screen md:w-20 md:flex-col md:justify-start md:gap-2 md:border-t-0 md:border-r md:py-6"
>
  {
    navItems.map((item) => (
      <a
        href={item.href}
        aria-label={item.label}
        aria-current={isActive(item.href) ? "page" : undefined}
        class:list={[
          "group flex flex-col items-center gap-0.5 rounded-xl px-3 py-2 text-[10px] transition-colors md:w-14 md:py-3 md:text-[11px]",
          isActive(item.href) ? "text-[var(--accent-sage-deep)]" : "text-[var(--text-muted)] hover:text-[var(--text)]"
        ]}
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          {item.icon === "home" && <path d="M3 11.5 12 4l9 7.5M5 10v9a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1v-9" />}
          {item.icon === "book" && (
            <>
              <path d="M4 5.5C4 4.7 4.7 4 5.5 4H12v16H5.5A1.5 1.5 0 0 1 4 18.5z" />
              <path d="M20 5.5C20 4.7 19.3 4 18.5 4H12v16h6.5a1.5 1.5 0 0 0 1.5-1.5z" />
            </>
          )}
          {item.icon === "bell" && (
            <>
              <path d="M6 16v-4.5a6 6 0 0 1 12 0V16l1.5 2.5h-15z" />
              <path d="M10 20a2 2 0 0 0 4 0" />
            </>
          )}
          {item.icon === "file" && (
            <>
              <path d="M7 3.5h7L18 8v12.5a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1v-16a1 1 0 0 1 1-1z" />
              <path d="M14 3.5V8h4" />
            </>
          )}
        </svg>
        <span class="md:hidden">{item.label}</span>
        <span class="hidden md:inline">{item.label}</span>
      </a>
    ))
  }

  <div class="hidden md:mt-auto md:flex md:w-full md:justify-center">
    <button
      id="theme-toggle"
      type="button"
      aria-label="Toggle dark mode"
      class="flex h-10 w-10 items-center justify-center rounded-full border border-[var(--border)] text-[var(--text-muted)] hover:text-[var(--text)]"
    >
      <svg id="theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2 12h2M20 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" />
      </svg>
      <svg id="theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="hidden" aria-hidden="true">
        <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" />
      </svg>
    </button>
  </div>
</nav>

<script is:inline>
  (function () {
    var btn = document.getElementById("theme-toggle");
    var sun = document.getElementById("theme-icon-sun");
    var moon = document.getElementById("theme-icon-moon");
    if (!btn) return;

    function currentTheme() {
      var attr = document.documentElement.getAttribute("data-theme");
      if (attr) return attr;
      return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    }

    function syncIcons() {
      var theme = currentTheme();
      if (sun && moon) {
        sun.classList.toggle("hidden", theme === "dark");
        moon.classList.toggle("hidden", theme !== "dark");
      }
    }

    btn.addEventListener("click", function () {
      var next = currentTheme() === "dark" ? "light" : "dark";
      document.documentElement.setAttribute("data-theme", next);
      try {
        localStorage.setItem("theme", next);
      } catch (e) {}
      syncIcons();
    });

    syncIcons();
  })();
</script>
